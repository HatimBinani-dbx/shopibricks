                    {
                      "name": "category",
                      "expression": "`category`"
                    },
                    {
                      "name": "purchases",
                      "expression": "`purchases`"
                    },
                    {
                      "name": "stockouts",
                      "expression": "`stockouts`"
                    },
                    {
                      "name": "revenue_at_risk_eur",
                      "expression": "`revenue_at_risk_eur`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "name",
